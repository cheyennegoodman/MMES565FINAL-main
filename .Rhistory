"Microspathodon chrysurus",
"Stegastes adustus",
"Damselfish spp",
"Stegastes planifrons",
"Stegastes leucostictus"
),
category,
"None"
)
)
View(CORAL_INTERACTION_DAM)
Coral_table <- table(CORAL_INTERACTION_DAM$code_meaning)
